#!/bin/bash
# HeadChicken: builds and packs the app.
#
#   scripts/package-headchicken   -> dist/HeadChicken-macos-<arch>.zip ("HeadChicken.app")
#   RUST_TARGET=x86_64-apple-darwin scripts/package-headchicken
#                                 -> dist/HeadChicken-macos-x86_64.zip (Intel, built on Apple silicon)
#   on Windows (Git Bash)         -> dist/HeadChicken-windows-x86_64.zip (a "HeadChicken" folder)
#
# A build from source on purpose: without HERDR_APP_RELEASE the app never
# checks Herdr's release server for updates and never sends usage reports.
# Signed ad hoc; Gatekeeper asks once on first open.
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
target=${RUST_TARGET:-}
if [[ -n $target ]]; then
  cargo build --release --locked --target "$target"
  bin="target/$target/release"
  arch=${target%%-*}
else
  cargo build --release --locked
  bin=target/release
  arch=$(uname -m)
fi
mkdir -p dist

case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*)
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    mkdir "$work/HeadChicken"
    cp "$bin/herdr-app.exe" "$work/HeadChicken/HeadChicken.exe"
    cp LICENSE THIRD-PARTY-NOTICES NOTICE.md "$work/HeadChicken/"
    out="dist/HeadChicken-windows-x86_64.zip"
    rm -f "$out"
    # 7z is a Windows program: hand it a Windows path.
    dest="$(cd dist && pwd -W)/HeadChicken-windows-x86_64.zip"
    (cd "$work" && 7z a -tzip -bso0 "$dest" HeadChicken)
    echo "package: $out ($version)"
    exit 0
    ;;
esac

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
app="$work/HeadChicken.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$bin/herdr-app" "$app/Contents/MacOS/HeadChicken"
cp assets/icons/HeadChicken.icns "$app/Contents/Resources/HeadChicken.icns"
cp LICENSE THIRD-PARTY-NOTICES NOTICE.md "$app/Contents/Resources/"
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>HeadChicken</string>
    <key>CFBundleIdentifier</key><string>io.github.brad-cat.headchicken</string>
    <key>CFBundleName</key><string>HeadChicken</string>
    <key>CFBundleDisplayName</key><string>HeadChicken</string>
    <key>CFBundleIconFile</key><string>HeadChicken</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$version</string>
    <key>CFBundleVersion</key><string>$version</string>
    <key>NSMicrophoneUsageDescription</key><string>Terminal programs running in HeadChicken can use the microphone, for example for voice input.</string>
    <key>NSCameraUsageDescription</key><string>Terminal programs running in HeadChicken can use the camera.</string>
    <key>NSAppleEventsUsageDescription</key><string>Terminal programs running in HeadChicken can use AppleScript to control other apps.</string>
    <key>NSPrincipalClass</key><string>NSApplication</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSEnvironment</key><dict/></dict></plist>
PLIST
codesign --force --deep --sign - "$app"
out="dist/HeadChicken-macos-$arch.zip"
rm -f "$out"
ditto -c -k --keepParent "$app" "$out"
echo "package: $out ($version)"
